generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum EsimStatus {
  NOT_ORDERED
  PROCESSING
  ISSUED
  DELIVERED
  FAILED
}

enum EmailDeliveryStatus {
  NOT_READY
  PENDING
  SENDING
  SENT
  FAILED
}

model AppSetting {
  id           String   @id @default("main")
  usdToPhpRate Float    @default(58)
  updatedAt    DateTime @updatedAt
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  phone         String?
  passwordHash  String
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(CUSTOMER)

  orders   Order[]
  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token String? @db.Text
  access_token  String? @db.Text
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String? @db.Text
  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model Order {
  id              String @id @default(cuid())
  referenceNumber String @unique

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  packageCode String
  planName    String

  customerName  String
  customerEmail String
  customerPhone String

  sellingPriceUsd   Float
  amountPhpCentavos Int
  usdToPhpRate      Float
  currency          String @default("PHP")

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  esimStatus    EsimStatus    @default(NOT_ORDERED)

  paymongoSessionId String?   @unique
  paymongoPaymentId String?   @unique
  paymongoEventId   String?   @unique
  paymentMethod     String?
  paidAt            DateTime?

  esimOrderId       String? @unique
  esimTransactionId String? @unique
  esimTranNo        String? @unique

  iccid          String? @unique
  qrCode         String? @db.Text
  qrCodeUrl      String? @db.Text
  activationCode String? @db.Text
  smdpAddress    String?
  matchingId     String?
  smdpStatus     String?

  supplierEsimStatus String?
  apn                String?

  esimRawResponse String?   @db.Text
  esimIssuedAt    DateTime?

  profileIssuedAt      DateTime?
  profileLastCheckedAt DateTime?
  profileCheckAttempts Int       @default(0)

  profileSyncClaimedAt  DateTime?
  profileSyncClaimId    String?
  profileSyncLeaseUntil DateTime?

  emailDeliveryStatus EmailDeliveryStatus @default(NOT_READY)

  emailSent     Boolean   @default(false)
  emailSentAt   DateTime?
  emailAttempts Int       @default(0)

  emailIdempotencyKey String? @unique
  resendEmailId       String? @unique

  emailClaimedAt  DateTime?
  emailClaimId    String?
  emailLeaseUntil DateTime?

  emailLastAttemptAt DateTime?
  emailLastError     String?   @db.Text

  processingAttempts Int       @default(0)
  lastAttemptAt      DateTime?
  lastError          String?   @db.Text

  webhookReceivedAt DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  refundedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([customerEmail])
  @@index([packageCode])
  @@index([status])
  @@index([paymentStatus])
  @@index([esimStatus])
  @@index([emailDeliveryStatus])
  @@index([paymentStatus, status, esimStatus, profileLastCheckedAt])
  @@index([paymentStatus, esimStatus, emailDeliveryStatus, emailLastAttemptAt])
  @@index([profileSyncLeaseUntil])
  @@index([emailLeaseUntil])
  @@index([createdAt])
}

model PlanSetting {
  id            String   @id @default(cuid())
  packageCode   String   @unique
  enabled       Boolean  @default(true)
  featured      Boolean  @default(false)
  markupPercent Float    @default(20)
  customName    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([enabled])
  @@index([featured])
}
